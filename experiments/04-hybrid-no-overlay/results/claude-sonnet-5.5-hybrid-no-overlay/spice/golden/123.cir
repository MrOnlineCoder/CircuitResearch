M7 net1 FCLK_3 VDD VDD PMOS_CI2N L={Lp} W={Wp}
M8 net4 FCLK_1 0 0 NMOS_CI2N L={Ln} W={Wn}
M9 net3 VREG net4 net4 NMOS_CI2N L={Ln} W={Wn}
M10 net2 VREF net4 net4 NMOS_CI2N L={Ln} W={Wn}
M11 net1 COMP net3 net3 NMOS_CI2N L={Ln} W={Wn}
M12 VDD FCLK_3 net3 net3 NMOS_CI2N L={Ln} W={Wn}
