M8 eout g89 0 0 NMOS_CI2N L={Ln} W={Wn}
M9 vg g89 0 0 NMOS_CI2N L={Ln} W={Wn}
M10 vg vg VDD VDD PMOS_CI2N L={Lp} W={Wp}
C1 eout n1 {Cval}
M11 tail vg VDD VDD PMOS_CI2N L={Lp} W={Wp}
M12 d12 n1 tail tail NMOS_CI2N L={Ln} W={Wn}
M13 d13 n2 tail tail NMOS_CI2N L={Ln} W={Wn}
M14 d12 d12 0 0 NMOS_CI2N L={Ln} W={Wn}
M15 d13 d13 0 0 NMOS_CI2N L={Ln} W={Wn}
M16 eout d12 0 0 NMOS_CI2N L={Ln} W={Wn}
M17 d19 d13 0 0 NMOS_CI2N L={Ln} W={Wn}
M18 eout d19 VDD VDD PMOS_CI2N L={Lp} W={Wp}
M19 d19 d19 VDD VDD PMOS_CI2N L={Lp} W={Wp}
