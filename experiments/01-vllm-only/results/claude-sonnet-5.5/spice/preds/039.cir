M1 net_a vg VDD VDD PMOS_CI2N L={Lp} W={Wp}
M2 Vref vg VDD VDD PMOS_CI2N L={Lp} W={Wp}
R1 net_a n1 {Rval}
R2 Vref net_b {Rval}
R3 net_b n2 {Rval}
R4 n1 net_c {Rval}
Q1 0 0 net_c NPN_CI2N
Q2 0 0 n2 NPN_CI2N
